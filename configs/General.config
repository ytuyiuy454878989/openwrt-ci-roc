### 通用配置文件 ###
# 此文件会在编译时由 Settings.sh 自动追加到 .config (最后追加，优先级最高)
# 用于添加上游配置文件中没有的 CONFIG_ 选项，或覆盖上游的默认值
# make defconfig 会自动处理依赖关系，无需手动解决依赖
## ============================================================
# 增加第三方插件 (上游没有或未启用)
## 主题类
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

## 系统工具
CONFIG_PACKAGE_luci-app-acme=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-emmc-health=y
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-app-onliner=y
CONFIG_PACKAGE_luci-app-socat=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-app-3cat=y
# luci-app-uhttpd 不存在，注释掉
# CONFIG_PACKAGE_luci-app-uhttpd=y

## 网络服务
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-app-frps=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-tailscale-community=y
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_easytier=y

## 存储打印
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-mini-diskmanager=y
CONFIG_PACKAGE_luci-app-p910nd=y

## 软件市场与容器
CONFIG_PACKAGE_luci-app-istorex=y
CONFIG_PACKAGE_luci-app-dockerman=y

## 代理/过滤类
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-app-openlist2=y
CONFIG_PACKAGE_luci-app-smartdns=y

## 其他
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-app-advancedplus=n

# ============================================================
# 禁用插件 (覆盖上游 =y 或移除不需要的)
# ============================================================
CONFIG_PACKAGE_luci-app-alist=n
CONFIG_PACKAGE_luci-app-quickfile=n
CONFIG_PACKAGE_luci-app-oaf=n
CONFIG_PACKAGE_luci-app-banip=n
CONFIG_PACKAGE_luci-app-arpbind=n
CONFIG_PACKAGE_luci-app-usb-printer=n
CONFIG_PACKAGE_luci-app-sqm=n
